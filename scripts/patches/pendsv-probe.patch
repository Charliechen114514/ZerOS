\ No newline at end of file
+} // namespace ZerOS::arch::cortex_m3
+
+// PendSV-only probe stamps (perf measurement, documents/notes/perf_1.md):
+// stamped by the naked asm in switch.cpp, but only when the build sets
+// ZEROS_MEASURE_PENDSV — otherwise they just sit at zero. extern "C"
+// because the assembly refers to them by their plain symbol names.
+extern "C" {
+extern volatile std::uint32_t zeros_pendsv_enter;
+extern volatile std::uint32_t zeros_pendsv_exit;
+}
