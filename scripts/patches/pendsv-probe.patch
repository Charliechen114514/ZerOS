+// PendSV-only probe (documents/notes/perf_1.md): two branch-free DWT
+// snapshots around the handler body; the perf demo does the post-analysis
+// on the raw delta. The probe costs ~24 cycles ON the measured path — a
+// fixed, documented addition, which is why it is build-gated: production
+// firmware pays nothing.
+extern "C" {
+volatile std::uint32_t zeros_pendsv_enter = 0;
+volatile std::uint32_t zeros_pendsv_exit = 0;
+}
+
+#ifdef ZEROS_MEASURE_PENDSV
+#    define ZEROS_PENDSV_PROBE_IN           \
+        "ldr     r1, =0xE0001004\n"         \
+        "ldr     r1, [r1]\n"                \
+        "ldr     r2, =zeros_pendsv_enter\n" \
+        "str     r1, [r2]\n"
+#    define ZEROS_PENDSV_PROBE_OUT         \
+        "ldr     r1, =0xE0001004\n"        \
+        "ldr     r1, [r1]\n"               \
+        "ldr     r2, =zeros_pendsv_exit\n" \
+        "str     r1, [r2]\n"
+#else
+#    define ZEROS_PENDSV_PROBE_IN ""
+#    define ZEROS_PENDSV_PROBE_OUT ""
+#endif
+
 extern "C" ZEROS_RAMFUNC std::uint32_t* context_switch(std::uint32_t* saved_sp) {
     using TaskGuardHelper = task::TaskGuardHelper;
     if (saved_sp != nullptr) {
@@ -96,13 +116,11 @@
 }
 
 extern "C" ZEROS_RAMFUNC [[gnu::naked]] void PendSV_Handler() {
-    asm volatile("cpsid   i\n"
-                 "mrs     r0, psp\n"
+    asm volatile("cpsid   i\n" ZEROS_PENDSV_PROBE_IN "mrs     r0, psp\n"
                  "cbz     r0, 1f\n"
                  "stmdb   r0!, {r4-r11}\n"
                  "1:\n"
-                 "bl      context_switch\n"
-                 "ldmia   r0!, {r4-r11}\n"
+                 "bl      context_switch\n" ZEROS_PENDSV_PROBE_OUT "ldmia   r0!, {r4-r11}\n"
                  "msr     psp, r0\n"
                  "ldr     lr, =0xFFFFFFFD\n"
                  "cpsie   i\n"
--- a/include/ZerOS/arch/arm_cortex_m3/switch.hpp
+++ b/include/ZerOS/arch/arm_cortex_m3/switch.hpp
@@ -27,4 +27,13 @@
 ZerOS::sched::TCB& spawn(ZerOS::sched::TCBCreator spec,
                          ZerOS::sched::TCBStorage& box);
 [[noreturn]] void start_scheduler(); // idle 栈内核自带
